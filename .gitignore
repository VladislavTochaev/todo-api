# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically shaved by its use
*.out

# Dependency directories (suggested to keep empty or exclude if using go mod)
# vendor/

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Environment variables / Secrets
.env
.env.local
.env.*.local

# OS generated files
.DS_Store
Thumbs.db
